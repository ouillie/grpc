# A small Bazel module to verify that
# `generate_py`, `py_proto_library`, `generate_cc`, `generate_objc`
# work when `--@grpc//bazel/toolchains:enable_grpc_plugin_toolchain_resolution` is enabled.
# Context:
# - https://github.com/grpc/grpc/issues/41275
# - https://github.com/grpc/grpc/issues/41273
module(
    name = "grpc_plugin_toolchain_resolution_test",
)

bazel_dep(name = "grpc")
local_path_override(
    module_name = "grpc",
    path = "../../..",
)

bazel_dep(name = "bazel_skylib", version = "1.9.0")
bazel_dep(name = "protobuf", version = "35.0")
bazel_dep(name = "rules_shell", version = "0.8.0")

# Use a recent version of BoringSSL because the one otherwise brought in transitively
# generates compiler warnings despite being compiled with -Werror, thus failing to build.
bazel_dep(name = "boringssl", version = "0.20260526.0")

# Dummy plugins standing in for the real gRPC plugins (see //:BUILD).
register_toolchains(
    "//:dummy_cpp_plugin_toolchain",
    "//:dummy_objective_c_plugin_toolchain",
    "//:dummy_python_plugin_toolchain",
)
